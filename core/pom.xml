<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cryptolab</groupId>
        <artifactId>crypto-strategy-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>
    <name>Crypto Strategy Lab :: Core</name>
    <description>Framework-independent domain, application services, and ports</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-core-dependency-isolation</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.cryptolab:infrastructure</exclude>
                                        <exclude>com.cryptolab:api-app</exclude>
                                        <exclude>com.cryptolab:worker-app</exclude>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.data:*</exclude>
                                        <exclude>org.springframework.amqp:*</exclude>
                                        <exclude>jakarta.persistence:*</exclude>
                                        <exclude>org.hibernate.orm:*</exclude>
                                        <exclude>com.binance:*</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>core must remain independent from application, framework, persistence, messaging, and Binance adapter dependencies.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
