# Copy this file to .env and replace local-only values as needed.
# Never commit the resulting .env file.

POSTGRES_DB=crypto_strategy_lab
POSTGRES_USER=crypto_lab
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=crypto_lab
RABBITMQ_PASSWORD=change-me

DATABASE_URL=jdbc:postgresql://localhost:55432/crypto_strategy_lab
API_PORT=8080
SESSION_COOKIE_SECURE=false
WORKER_MANAGEMENT_PORT=8081
APP_GIT_COMMIT=dev
APP_BUILD_VERSION=dev
DEFAULT_ACCOUNT_ENABLED=true
DEFAULT_ACCOUNT_USERNAME=demo
DEFAULT_ACCOUNT_PASSWORD=crypto-demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DISCOVERY_POLL_INTERVAL=1m
CRYPTO_MARKET_PROVIDER=binance
BINANCE_REST_URL=https://api.binance.com/api/v3/klines
BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws
OKX_REST_URL=https://www.okx.com/api/v5/market/history-candles
OKX_WEBSOCKET_URL=wss://ws.okx.com:8443/ws/v5/public
CRYPTO_MARKET_SUPPORTED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
CRYPTO_MARKET_MAXIMUM_RANGE_CANDLES=20000
NEWS_PROVIDER=all
NEWS_API_URL=https://min-api.cryptocompare.com/data/v2/news/
NEWS_API_KEY=
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
SENTIMENT_PROVIDER=keyword
CRAWLER_CHECK_INTERVAL=15m
